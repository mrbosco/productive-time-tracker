sequenceDiagram
    autonumber
    actor U as User
    participant App as Time Tracker (browser)
    participant LS as localStorage
    participant API as Productive API

    U->>App: Enter API token + organization ID
    App->>API: GET /organization_memberships (X-Auth-Token, X-Organization-Id)
    alt 401 / 403 / network error
        API-->>App: errors[]
        App-->>U: Inline error on login form
    else 200
        API-->>App: memberships[] (+ person relationship)
        App->>App: find membership where organization.id == entered ID
        alt no match
            App-->>U: "Token is valid but not a member of organization X"
        else match
            App->>API: GET /services (person-scoped) to resolve default service
            App->>LS: save { token, organizationId, personId, defaultServiceId }
            App-->>U: redirect to /day/today
        end
    end

    Note over App,LS: On refresh: read LS, re-validate with one GET /organization_memberships
    U->>App: Logout
    App->>LS: clear key
    App->>App: clear query cache, redirect /login
